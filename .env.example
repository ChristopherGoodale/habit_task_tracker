# Postgres (used by docker-compose.yml and the Go server)
POSTGRES_USER=habit_tracker
POSTGRES_PASSWORD=habit_tracker
POSTGRES_DB=habit_tracker
POSTGRES_PORT=5432

# Full connection string the Go server uses
DATABASE_URL=postgres://habit_tracker:habit_tracker@localhost:5432/habit_tracker?sslmode=disable

# Go server
PORT=8080

# Allowed origin for CORS (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
